{
  "manifest_version": 3,
  "name": "批注器 · PDF / EPUB / 网页批注 + LLM",
  "version": "0.1.0",
  "description": "自建 PDF/EPUB/网页阅读器，文字级高亮批注；可选接入 DeepSeek / OpenAI / Ollama 等任意 OpenAI 兼容服务（第三方客户端，key 由用户自备）。",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开批注面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "open-current-in-reader": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "用批注器打开当前标签页"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "reader/*",
        "vendor/*",
        "icons/*",
        "shared/*",
        "sidepanel/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src 'none'"
  }
}
